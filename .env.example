API_PORT=3001    #Backend API Port 
FRONT_PORT=3000    #Backend API Port
MONGO_URL=mongodb://<USER>:<PASSWORD>@<IP_ADDRESS>:27017/<DB_NAME>  #In Case no user and password remove <USER>:<PASSWORD>@
BASE_URL=http://IP_ADDRESS:<API_PORT>
WEB_URL=http://IP_ADDRESS:<FRONT_PORT>
PRODUCTION=true    #true/false
SSL_PVT_KEY=       #For ssl configuration
SSL_CERT=          #For ssl configuration
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
APPLE_WEB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#gemini
GEMINI_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SMTP_SECURE=false #true/false
WHITELIST_ORIGINS=http://localhost:<FRONT_PORT>    

